<h1>Welcome to Zipkart</h1>

<h1>Customer Home</h1>
<%= link_to "View Products", products_path %>

<% if user_signed_in? %>
  <% if current_user.vendor.present? %>
  <%= link_to "Switch to Vendor Account", vendor_path %>
  <% else %>
  <p> Want to register as a vendor? </p>
  <%= link_to "Become Vendor" , new_vendor_path %>
  <% end %>

<% else %>
  <%= link_to "Sign Up", new_user_registration_path %>
  <%= link_to "Login", new_user_session_path %>
<% end %>