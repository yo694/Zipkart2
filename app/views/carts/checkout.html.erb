
<h1>Checkout</h1>

<h2>Order Summary</h2>

<% @cart_items.each do |item| %>
  <h3><%= item.product_variant.product.product_name %></h3>

  <p>Colour: <%= item.product_variant.colour %></p>
  <p>Size: <%= item.product_variant.size %></p>
  <p>Price: ₹<%= item.price %></p>
  <p>Quantity: <%= item.qty %></p>

  <p>
    Subtotal: ₹<%= item.price * item.qty %>
  </p>

  <hr>
<% end %>

<h2>Total: ₹<%= @total_amount %></h2>

<%= button_to "Place Order", orders_path, method: :post %>

<%= link_to "Back to Cart", cart_path(@cart) %>
