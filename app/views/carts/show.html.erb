
<h1>My Shopping Cart</h1>

<% @cart_items.each do |item| %>
  <h3><%= item.product_variant.product.product_name %></h3>

  <p>Colour: <%= item.product_variant.colour %></p>
  <p>Size: <%= item.product_variant.size %></p>
  <p>Model: <%= item.product_variant.model %></p>
  <p>Price: ₹<%= item.price %></p>
  <p>Quantity: <%= item.qty%></p>

  <hr>
<% end %>

<%= link_to "Edit Cart", edit_cart_path(@cart) %>
<%= link_to "Continue Shopping", products_path %>

<%= button_to "Delete Entire Cart",
    cart_path(@cart),
    method: :delete,
    data: { confirm: "Are you sure you want to delete your cart?" } %>
