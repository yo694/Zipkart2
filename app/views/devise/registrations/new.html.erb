<h1>Sign Up</h1>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>

   <div>
       <%= f.label :name %>
       <%= f.text_field :name %>
    </div>

   <div>
       <%= f.label :email %>
       <%=  f.email_field :email %>
    </div>

       <div>
       <%= f.label :phone %>
       <%= f.text_field :phone %>
    </div>

   <div>
       <%= f.label :password %>
       <%=  f.password_field :password %>
    </div>

   <div>
       <%= f.label :password_confirmation %>
       <%=  f.password_field :password_confirmation %>
    </div>

   <div>
       <%= f.submit "Sign Up" %>
    </div>

<% end %>