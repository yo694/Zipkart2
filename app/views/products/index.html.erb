<h1>All Products</h1>

<% @products.each do |product| %>
  <h3><%= product.product_name %></h3>
  <p><%= product.description %></p>

  <%= link_to "View", product_path(product) %>

  <% if current_user.vendor %>
    <%= link_to "Edit", edit_product_path(product) %>
    <%= button_to "Delete", product_path(product), method: :delete %>
  <% end %>
<% end %>
<% if @products.total_pages > 1 %>
  <div>
    <%= link_to "Previous", url_for(page: @products.prev_page) if @products.prev_page %>

    <% (1..@products.total_pages).each do |page| %>
      <%= link_to page, url_for(page: page) %>
    <% end %>

    <%= link_to "Next", url_for(page: @products.next_page) if @products.next_page %>
  </div>
<% end %>