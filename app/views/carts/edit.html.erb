
<h1>Edit My Cart</h1>

<%= form_with model: @cart do |f| %>

  <%= f.fields_for :cart_items do |item| %>

    <h3><%= item.object.product_variant.product.product_name %></h3>

    <p>Colour: <%= item.object.product_variant.colour %></p>
    <p>Size: <%= item.object.product_variant.size %></p>
    <p>Model: <%= item.object.product_variant.model %></p>
    <p>Price: ₹<%= item.object.price %></p>

    <p>
      <%= item.label :quantity %>
      <%= item.number_field :qty, min: 1 %>
    </p>

    <p>
      <%= item.check_box :_destroy %>
      <%= item.label :_destroy, "Remove this item" %>
    </p>

    <hr>
  <% end %>

  <%= f.submit "Update Cart" %>

<% end %>

<%= link_to "Back to Cart", cart_path(@cart) %>
